<UserControl x:Class="Cucina_POO.View.NovoPedidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="White">

    <Grid Margin="40,30,40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- título -->
            <RowDefinition Height="Auto"/>  <!-- cliente -->
            <RowDefinition Height="Auto"/>  <!-- produto -->
            <RowDefinition Height="*"/>     <!-- lista + lado direito -->
            <RowDefinition Height="Auto"/>  <!-- total e botões -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Novo Pedido" Style="{StaticResource TituloTela}"/>

        <!-- Cliente -->
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cliente" Style="{StaticResource Rotulo}"/>

            <ComboBox x:Name="CmbCliente"
              Grid.Column="1"
              Height="28"
              IsEditable="True"
              IsTextSearchEnabled="True"
              StaysOpenOnEdit="True"
              TextSearch.TextPath="Nome"
              FontSize="12"
              VerticalContentAlignment="Center"/>

        </Grid>

        <!-- Produto -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Produto" Style="{StaticResource Rotulo}"/>
            <ComboBox x:Name="CmbProduto"
              Grid.Column="1"
              Height="28"
              IsEditable="True"
              IsTextSearchEnabled="True"
              StaysOpenOnEdit="True"
              TextSearch.TextPath="Nome"
              FontSize="12"
              VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Lista de itens (esquerda) e quantidade/pagamento (direita) -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="ListaItens" Grid.Column="0" Margin="0,0,24,0"
                      BorderBrush="Black" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Produto" Width="300"/>
                        <GridViewColumn Header="Qtd" Width="60"/>
                        <GridViewColumn Header="Preço" Width="90"/>
                        <GridViewColumn Header="Subtotal" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Quantidade" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="TxtQuantidade" Style="{StaticResource CaixaTexto}"
                         Width="70" HorizontalAlignment="Left" Margin="0,6,0,8" Text="1"/>
                <Button x:Name="BtnAdicionar" Content="Adicionar"
                        Style="{StaticResource BotaoPrimario}"
                        Width="110" HorizontalAlignment="Left"/>

                <TextBlock Text="Formas de Pagamento" Style="{StaticResource Rotulo}"
                           Margin="0,28,0,8"/>
                <UniformGrid Columns="2">
                    <RadioButton x:Name="RbPix" GroupName="Pagamento" Content="Pix" Margin="0,0,0,8"/>
                    <RadioButton x:Name="RbDinheiro" GroupName="Pagamento" Content="Dinheiro" Margin="0,0,0,8"/>
                    <RadioButton x:Name="RbCredito" GroupName="Pagamento" Content="Crédito"/>
                    <RadioButton x:Name="RbDebito" GroupName="Pagamento" Content="Débito"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- Total e botões -->
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Total do pedido" Style="{StaticResource Rotulo}"
                           FontSize="18" Margin="0,0,12,0"/>
                <TextBox x:Name="TxtTotal" Style="{StaticResource CaixaTexto}"
                         Width="140" IsReadOnly="True" Text="R$ 0,00"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Button x:Name="BtnRealizar" Content="Realizar pedido"
                        Style="{StaticResource BotaoPrimario}"
                        Width="180" HorizontalAlignment="Left"/>
                <Button x:Name="BtnCancelar" Content="Cancelar"
                        Style="{StaticResource BotaoPrimario}"
                        Width="180" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>