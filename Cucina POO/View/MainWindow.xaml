<Window x:Class="Cucina_POO.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cucina_POO"
        mc:Ignorable="d"
        Title="P.O.O Cucina" Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontePadrao}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="{StaticResource PincelMenu}">
            <DockPanel>

                <Image DockPanel.Dock="Top" Source="/Assets/logo-poo-cucina.png"
                       Width="80" Margin="0,16,0,24"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,16" Cursor="Hand">
                    <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="14"
                               Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="10" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <RadioButton x:Name="BtnPedido" GroupName="Menu" IsChecked="True"
                                 Style="{StaticResource BotaoMenu}" ToolTip="Novo Pedido">
                        <Image Source="/Assets/novo-pedido.png" Width="28"/>
                    </RadioButton>

                    <RadioButton x:Name="BtnProdutos" GroupName="Menu"
                                 Style="{StaticResource BotaoMenu}" ToolTip="Cadastro de Produtos">
                        <Image Source="/Assets/food-bar.png" Width="28"/>
                    </RadioButton>

                    <RadioButton x:Name="BtnStatus" GroupName="Menu"
                                 Style="{StaticResource BotaoMenu}" ToolTip="Status dos Pedidos">
                        <Image Source="/Assets/status-pedido.png" Width="28"/>
                    </RadioButton>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Área onde cada tela vai aparecer -->
        <Border Grid.Column="1" Background="White">
            <ContentControl x:Name="AreaConteudo"/>
        </Border>
    </Grid>
</Window>
