<UserControl x:Class="Cucina_POO.View.StatusPedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="White"
             FontFamily="{DynamicResource FontePadrao}">

    <UserControl.Resources>

        <!-- AQUI SERÃO TROCADOS PELOS PEDIDOS QUE ATHMA DISSE -->
        <x:Array x:Key="PedidosExemplo" Type="sys:String">
            <sys:String>053 - Fred</sys:String>
            <sys:String>045 - VH</sys:String>
            <sys:String>029 - Lyanco</sys:String>
            <sys:String>017 - Renan</sys:String>
            <sys:String>012 - Delfim</sys:String>
            <sys:String>004 - Cuello</sys:String>
        </x:Array>

        <!-- TEMPLATE DOS TEXTINHOS DE CADA ETAPA -->
        <Style x:Key="Etapa" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </UserControl.Resources>

    <DockPanel Margin="40,30,40,20">

        <!-- Título -->
        <TextBlock DockPanel.Dock="Top" Text="Status dos pedidos"
                   Style="{StaticResource TituloTela}"
                   HorizontalAlignment="Center" Margin="0,0,0,24"/>

        <!-- Grade de cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{StaticResource PedidosExemplo}"
                          HorizontalAlignment="Center">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- CARD DE EXEMPLO: Athma substitui pelo real -->
                        <Border Width="190" Height="190" Margin="12"
                                Padding="12,10" Background="White"
                                BorderBrush="Black" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding}"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                <TextBlock DockPanel.Dock="Bottom" Text="• Pedido Finalizado"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etapa}" Text="• Pedido Registrado"/>
                                    <TextBlock Style="{StaticResource Etapa}" Text="• Enviado para cozinha"/>
                                    <TextBlock Style="{StaticResource Etapa}" Text="• Em preparação"/>
                                    <TextBlock Style="{StaticResource Etapa}" Text="• Pronto para retirada!"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>